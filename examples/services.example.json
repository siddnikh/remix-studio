{
  "_read_me": "Copy to ~/.config/remix-studio/services.json and keep only the service you use. Put keys in ~/.config/remix-studio/env as NAME=value. These entries follow each provider's public API shape and have NOT been run: replace the model name, its input fields and the price from the model's own page, then run one canary.",

  "replicate": {
    "_comment": "Model inputs differ per model. Check them on the model's API page. Replicate has no idempotency header here, so a submit that gets no answer has to be reconciled by hand.",
    "submit": {
      "url": "https://api.replicate.com/v1/models/OWNER/MODEL/predictions",
      "headers": {"Authorization": "Bearer ${REPLICATE_API_TOKEN}"}
    },
    "task_id_path": "id",
    "poll": {
      "url": "https://api.replicate.com/v1/predictions/{task_id}",
      "headers": {"Authorization": "Bearer ${REPLICATE_API_TOKEN}"}
    },
    "status_path": "status",
    "succeeded": ["succeeded"],
    "failed": ["failed", "canceled"],
    "error_path": "error",
    "result_url_path": "output",
    "job_body": {
      "input": {
        "prompt": "{prompt}",
        "reference_videos": ["{video_url}"],
        "reference_images": "{image_urls}",
        "duration": "{duration_s}",
        "resolution": "{resolution}",
        "aspect_ratio": "{aspect_ratio}"
      }
    },
    "tags": {"video": "@video{n}", "image": "@image{n}"},
    "price": {"currency": "USD", "per_second": {"480p": 0.2}, "bill_reference_seconds": true}
  },

  "fal": {
    "_comment": "fal's queue API returns the output from a separate result endpoint.",
    "submit": {
      "url": "https://queue.fal.run/OWNER/MODEL",
      "headers": {"Authorization": "Key ${FAL_KEY}"}
    },
    "task_id_path": "request_id",
    "poll": {
      "url": "https://queue.fal.run/OWNER/MODEL/requests/{task_id}/status",
      "headers": {"Authorization": "Key ${FAL_KEY}"}
    },
    "status_path": "status",
    "succeeded": ["COMPLETED"],
    "failed": ["FAILED", "ERROR"],
    "result": {
      "url": "https://queue.fal.run/OWNER/MODEL/requests/{task_id}",
      "headers": {"Authorization": "Key ${FAL_KEY}"}
    },
    "result_url_path": "video.url",
    "job_body": {
      "prompt": "{prompt}",
      "video_urls": ["{video_url}"],
      "image_urls": "{image_urls}",
      "duration": "{duration_s}",
      "resolution": "{resolution}",
      "aspect_ratio": "{aspect_ratio}"
    },
    "tags": {"video": "@video{n}", "image": "@image{n}"},
    "price": {"currency": "USD", "per_second": {"480p": 0.2}, "bill_reference_seconds": true}
  }
}
